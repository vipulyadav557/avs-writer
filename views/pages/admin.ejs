
<%- include('../partials/header') %>



<div class="admin-page">

  <div class="admin-header">
    <h1>Admin Dashboard</h1>

    <div class="admin-user">
      <span>Welcome, <%= user?.name || 'Admin' %></span>
      <form action="/auth/logout" method="POST" class="logout-form">
  <button class="btn btn-ghost btn-sm" type="submit">Logout</button>
</form>
    </div>
  </div>

  <% if (!dbAvailable) { %>

    <p class="empty">
      Database not configured. Content management is unavailable.
    </p>

  <% } else { %>

    <!-- Dashboard Statistics -->

    <div class="admin-stats">
      <div class="stat-card">
        <h3><%= stats.poems %></h3>
        <p>Total Poems</p>
      </div>

      <div class="stat-card">
        <h3><%= stats.pending || 0 %></h3>
        <p>Pending Approval</p>
      </div>

      <div class="stat-card">
        <h3><%= stats.books %></h3>
        <p>Total Books</p>
      </div>

      <div class="stat-card">
        <h3><%= stats.contacts %></h3>
        <p>Messages</p>
      </div>

      <div class="stat-card">
        <h3><%= stats.users %></h3>
        <p>Registered Users</p>
      </div>
    </div>

    <!-- Admin Quick Navigation -->

    <section class="admin-navigation">

      <a href="/admin/users" class="admin-nav-card">
        <div class="admin-nav-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
        <div class="admin-nav-content">
          <strong>User Management</strong>
          <span>Manage writer accounts and access permissions</span>
        </div>
      </a>

      <a href="#poem-management" class="admin-nav-card">
        <div class="admin-nav-icon"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i></div>
        <div class="admin-nav-content">
          <strong>Poem Management</strong>
          <span>Review, publish and manage poems</span>
        </div>
      </a>

      <a href="#book-management" class="admin-nav-card">
        <div class="admin-nav-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></div>
        <div class="admin-nav-content">
          <strong>Book Management</strong>
          <span>Upload, edit and manage published books</span>
        </div>
      </a>

      <a href="#contact-management" class="admin-nav-card">
        <div class="admin-nav-icon"><i class="fa-solid fa-envelope" aria-hidden="true"></i></div>
        <div class="admin-nav-content">
          <strong>Contact Messages</strong>
          <span>View and manage incoming messages</span>
        </div>
      </a>

    </section>

    <!-- Add New Poem -->

    <section class="admin-section">
      <h2>Add New Poem</h2>

      <form method="POST" action="/admin/poems/add" class="admin-form">

        <div>
          <label for="poem-title">Poem Title *</label>
          <input type="text" id="poem-title" name="title"
                 maxlength="200" required>
        </div>

        <div>
          <label for="poem-author">Author Name</label>
          <input type="text" id="poem-author" name="author"
                 maxlength="100" placeholder="Writer name">
        </div>

        <div class="full-width">
          <label for="poem-body">Poem Content *</label>
          <textarea id="poem-body" name="body" rows="9" required></textarea>
        </div>

        <div>
          <label for="poem-category">Category *</label>
          <select id="poem-category" name="category" required>
            <option value="">Select Category</option>
            <option value="Shayari">Shayari</option>
            <option value="Ghazal">Ghazal</option>
            <option value="Nazm">Nazm</option>
            <option value="Kavita">Kavita</option>
            <option value="Bhojpuri Song">Bhojpuri Song</option>
            <option value="Kahani">Kahani</option>
          </select>
        </div>

        <div>
          <label for="poem-language">Language *</label>
          <select id="poem-language" name="language" required>
            <option value="">Select Language</option>
            <option value="Hindi">Hindi</option>
            <option value="Urdu">Urdu</option>
            <option value="English">English</option>
            <option value="Bhojpuri">Bhojpuri</option>
          </select>
        </div>

        <div>
          <label for="poem-mood">Mood</label>
          <input type="text" id="poem-mood" name="mood"
                 maxlength="50" placeholder="Love, Sad, Motivation...">
        </div>

        <div>
          <label for="poem-tags">Tags</label>
          <input type="text" id="poem-tags" name="tags"
                 placeholder="Love, Life, Friendship">
        </div>

        <div class="full-width">
          <label for="poem-image">Image URL (Optional)</label>
          <input type="url" id="poem-image" name="imageUrl"
                 placeholder="https://example.com/image.jpg">
        </div>

        <div>
          <label for="poem-status">Publishing Status</label>
          <select id="poem-status" name="status">
            <option value="draft">Save as Draft</option>
            <option value="published">Publish Now</option>
          </select>
        </div>

        <div class="full-width">
          <button class="btn" type="submit">Add Poem</button>
        </div>

      </form>
    </section>

    <!-- Poem Management -->

    <section class="admin-section" id="poem-management">
      <h2>Poem Management (<%= stats.poems %>)</h2>

      <% if (!poems.length) { %>
        <p class="empty">No poems available yet.</p>
      <% } else { %>

        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Author</th>
                <th>Attachments</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% poems.forEach(p => { %>
                <tr>
                  <td><%= p.title %></td>
                  <td><%= p.category %></td>
                  <td><%= p.author || 'AVS Writer' %></td>

                  <td>
                    <div class="book-file-links">
                      <% if (p.imageMimeType) { %>
                        <a href="/admin/poems/<%= p.poemId %>/attachment/image"
                           target="_blank">View Image</a>
                      <% } %>

                      <% if (p.documentMimeType) { %>
                        <a href="/admin/poems/<%= p.poemId %>/attachment/pdf">
                          Download PDF
                        </a>
                      <% } %>

                      <% if (!p.imageMimeType && !p.documentMimeType) { %>
                        -
                      <% } %>
                    </div>
                  </td>

                  <td>
                    <span class="admin-status status-<%= p.status %>">
                      <%= p.status %>
                    </span>

                    <% if (p.isFeatured) { %>
                      <span class="admin-status status-featured">Featured</span>
                    <% } %>
                  </td>

                  <td>
                    <%= p.createdAt
                      ? new Date(p.createdAt).toLocaleDateString()
                      : '-' %>
                  </td>

                  <td>
                    <div class="admin-actions">

                      <% if (p.status === 'published') { %>
                        <a class="btn btn-sm"
                           href="/poems/<%= p.slug %>"
                           target="_blank">View</a>

                        <form method="POST"
                              action="/admin/poems/<%= p.poemId %>/featured">
                          <input type="hidden" name="featured"
                                 value="<%= p.isFeatured ? 'false' : 'true' %>">
                          <button class="btn btn-sm" type="submit">
                            <%= p.isFeatured ? 'Remove Featured' : 'Make Featured' %>
                          </button>
                        </form>

                        <form method="POST"
                              action="/admin/poems/<%= p.poemId %>/status">
                          <input type="hidden" name="status" value="draft">
                          <button class="btn btn-sm" type="submit">Unpublish</button>
                        </form>
                      <% } else { %>
                        <form method="POST"
                              action="/admin/poems/<%= p.poemId %>/status">
                          <input type="hidden" name="status" value="published">
                          <button class="btn btn-sm" type="submit">
                            <%= p.status === 'pending' ? 'Approve & Publish' : 'Publish' %>
                          </button>
                        </form>
                      <% } %>

                      <% if (p.status !== 'rejected') { %>
                        <form method="POST"
                              action="/admin/poems/<%= p.poemId %>/status">
                          <input type="hidden" name="status" value="rejected">
                          <button class="btn btn-sm" type="submit">Reject</button>
                        </form>
                      <% } else { %>
                        <form method="POST"
                              action="/admin/poems/<%= p.poemId %>/status">
                          <input type="hidden" name="status" value="draft">
                          <button class="btn btn-sm" type="submit">Move to Draft</button>
                        </form>
                      <% } %>

                      <form method="POST"
                            action="/admin/poems/<%= p.poemId %>/delete"
                            data-confirm="Delete this poem permanently?">
                        <button class="btn btn-sm" type="submit">Delete</button>
                      </form>

                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      <% } %>
    </section>

    <!-- Add New Book -->

    <section class="admin-section">
      <h2>Upload New Book</h2>

      <p class="admin-help">
        Only Admin can upload books. PDF is required. Cover image is optional.
        Supported cover formats: JPG, PNG and WebP.
      </p>

      <form method="POST"
            action="/admin/books/add"
            enctype="multipart/form-data"
            class="admin-form">

        <div>
          <label for="book-title">Book Title *</label>
          <input type="text" id="book-title" name="title"
                 maxlength="250" required>
        </div>

        <div>
          <label for="book-subtitle">Subtitle</label>
          <input type="text" id="book-subtitle" name="subtitle"
                 maxlength="250">
        </div>

        <div>
          <label for="book-author">Author Name</label>
          <input type="text" id="book-author" name="author"
                 maxlength="150" placeholder="Author name">
        </div>

        <div>
          <label for="book-language">Language *</label>
          <select id="book-language" name="language" required>
            <option value="">Select Language</option>
            <% ['Hindi', 'Urdu', 'English', 'Bhojpuri'].forEach(language => { %>
              <option value="<%= language %>"><%= language %></option>
            <% }) %>
          </select>
        </div>

        <div class="full-width">
          <label for="book-description">Description</label>
          <textarea id="book-description" name="description"
                    rows="5"></textarea>
        </div>

        <div>
          <label for="book-categories">Categories *</label>
          <select id="book-categories" name="categories" multiple required>
            <% [
              'Life Experiences',
              'Self Improvement',
              'Relationships',
              'Life Lessons',
              'Personal Experiences',
              'Poetry',
              'Shayari',
              'Ghazal',
              'Nazm',
              'Kahani',
              'Bhojpuri Songs',
              'Fiction',
              'Non-Fiction',
              'Memoir'
            ].forEach(category => { %>
              <option value="<%= category %>"><%= category %></option>
            <% }) %>
          </select>
          <small>Select one or more categories. Use Ctrl to select multiple.</small>
        </div>

        <div>
          <label for="book-cover">Cover Image</label>
          <input type="file" id="book-cover" name="cover"
                 accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
        </div>

        <div class="full-width">
          <label for="book-pdf">Book PDF *</label>
          <input type="file" id="book-pdf" name="pdf"
                 accept=".pdf,application/pdf" required>
          <small>PDF upload limit: 50 MB.</small>
        </div>

        <div>
          <label for="book-isbn">ISBN</label>
          <input type="text" id="book-isbn" name="isbn">
        </div>

        <div>
          <label for="book-publisher">Publisher</label>
          <input type="text" id="book-publisher" name="publisher">
        </div>

        <div>
          <label for="book-date">Published Date</label>
          <input type="date" id="book-date" name="publishedDate">
        </div>

        <div>
          <label for="book-pages">Number of Pages</label>
          <input type="number" id="book-pages" name="pages" min="0">
        </div>

        <div>
          <label for="book-price">Price</label>
          <input type="number" id="book-price" name="price"
                 min="0" step="0.01" value="0">
        </div>

        <div>
          <label for="book-status">Publishing Status</label>
          <select id="book-status" name="status">
            <option value="draft">Save as Draft</option>
            <option value="published">Publish Now</option>
          </select>
        </div>

        <div class="full-width">
          <label for="book-toc">Table of Contents</label>
          <textarea id="book-toc" name="tableOfContents"
                    rows="4"
                    placeholder="One chapter per line"></textarea>
        </div>

        <div class="full-width">
          <label for="book-learn">What Readers Will Learn</label>
          <textarea id="book-learn" name="whatReadersLearn"
                    rows="4"
                    placeholder="One point per line"></textarea>
        </div>

        <div class="full-width">
          <label for="book-author-intro">About the Author</label>
          <textarea id="book-author-intro" name="authorIntro"
                    rows="4"></textarea>
        </div>

        <div class="full-width">
          <button class="btn" type="submit">Upload Book</button>
        </div>

      </form>
    </section>

    <!-- Book Management -->

    <section class="admin-section" id="book-management">
      <h2>Book Management (<%= stats.books %>)</h2>

      <% if (!books.length) { %>
        <p class="empty">No books available yet.</p>
      <% } else { %>

        <% books.forEach(b => { %>
          <div class="book-edit">

            <div class="admin-header">
              <div>
                <strong><%= b.title %></strong>
                <div class="admin-help">
                  <%= b.author || 'Unknown Author' %> |
                  <%= b.language %> |
                  <span class="admin-status status-<%= b.status %>">
                    <%= b.status %>
                  </span>
                </div>
              </div>

              <div class="book-file-links">
                <% if (b.status === 'published') { %>
                  <a class="btn btn-sm"
                     href="/books/<%= b.slug %>"
                     target="_blank">View Public Page</a>
                <% } %>

                <% if (b.coverUrl) { %>
                  <a class="btn btn-sm"
                     href="/admin/books/<%= b._id %>/file/cover"
                     target="_blank">View Cover</a>
                <% } %>

                <% if (b.pdfPath || b.pdfUrl) { %>
                  <a class="btn btn-sm"
                     href="/admin/books/<%= b._id %>/file/pdf"
                     target="_blank">Preview PDF</a>
                <% } %>
              </div>
            </div>

            <details>
              <summary>Edit Book Details</summary>

              <form method="POST"
                    action="/admin/books/<%= b._id %>/edit"
                    enctype="multipart/form-data"
                    class="admin-form">

                <div>
                  <label>Book Title *</label>
                  <input type="text" name="title"
                         value="<%= b.title %>" required>
                </div>

                <div>
                  <label>Subtitle</label>
                  <input type="text" name="subtitle"
                         value="<%= b.subtitle || '' %>">
                </div>

                <div>
                  <label>Author</label>
                  <input type="text" name="author"
                         value="<%= b.author || '' %>">
                </div>

                <div>
                  <label>Language *</label>
                  <select name="language" required>
                    <% ['Hindi', 'Urdu', 'English', 'Bhojpuri'].forEach(language => { %>
                      <option value="<%= language %>"
                        <%= b.language === language ? 'selected' : '' %>>
                        <%= language %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="full-width">
                  <label>Description</label>
                  <textarea name="description" rows="4"><%= b.description || '' %></textarea>
                </div>

                <div>
                  <label>Categories *</label>
                  <select name="categories" multiple required>
                    <% [
                      'Life Experiences',
                      'Self Improvement',
                      'Relationships',
                      'Life Lessons',
                      'Personal Experiences',
                      'Poetry',
                      'Shayari',
                      'Ghazal',
                      'Nazm',
                      'Kahani',
                      'Bhojpuri Songs',
                      'Fiction',
                      'Non-Fiction',
                      'Memoir'
                    ].forEach(category => { %>
                      <option value="<%= category %>"
                        <%= (b.categories || []).includes(category) ? 'selected' : '' %>>
                        <%= category %>
                      </option>
                    <% }) %>
                  </select>
                  <small>Use Ctrl to select multiple categories.</small>
                </div>

                <div>
                  <label>Replace Cover Image</label>
                  <input type="file" name="cover"
                         accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                </div>

                <div class="full-width">
                  <label>Replace Book PDF</label>
                  <input type="file" name="pdf"
                         accept=".pdf,application/pdf">
                  <small>Leave empty to keep the existing PDF.</small>
                </div>

                <div>
                  <label>ISBN</label>
                  <input type="text" name="isbn"
                         value="<%= b.isbn || '' %>">
                </div>

                <div>
                  <label>Publisher</label>
                  <input type="text" name="publisher"
                         value="<%= b.publisher || '' %>">
                </div>

                <div>
                  <label>Published Date</label>
                  <input type="date" name="publishedDate"
                         value="<%= b.publishedDate
                           ? new Date(b.publishedDate).toISOString().slice(0, 10)
                           : '' %>">
                </div>

                <div>
                  <label>Pages</label>
                  <input type="number" name="pages"
                         min="0" value="<%= b.pages || 0 %>">
                </div>

                <div>
                  <label>Price</label>
                  <input type="number" name="price"
                         min="0" step="0.01" value="<%= b.price || 0 %>">
                </div>

                <div>
                  <label>Status</label>
                  <select name="status">
                    <option value="draft"
                      <%= b.status === 'draft' ? 'selected' : '' %>>
                      Draft
                    </option>
                    <option value="published"
                      <%= b.status === 'published' ? 'selected' : '' %>>
                      Published
                    </option>
                  </select>
                </div>

                <div class="full-width">
                  <label>Table of Contents</label>
                  <textarea name="tableOfContents" rows="4"><%=
                    Array.isArray(b.tableOfContents)
                      ? b.tableOfContents.join('\n')
                      : ''
                  %></textarea>
                </div>

                <div class="full-width">
                  <label>What Readers Will Learn</label>
                  <textarea name="whatReadersLearn" rows="4"><%=
                    Array.isArray(b.whatReadersLearn)
                      ? b.whatReadersLearn.join('\n')
                      : ''
                  %></textarea>
                </div>

                <div class="full-width">
                  <label>About the Author</label>
                  <textarea name="authorIntro" rows="4"><%= b.authorIntro || '' %></textarea>
                </div>

                <div class="full-width">
                  <button class="btn" type="submit">Save Book Changes</button>
                </div>

              </form>
            </details>

            <hr class="admin-divider">

            <div class="admin-actions">

              <% if (b.status === 'published') { %>
                <form method="POST"
                      action="/admin/books/<%= b._id %>/status">
                  <input type="hidden" name="status" value="draft">
                  <button class="btn btn-sm" type="submit">Unpublish</button>
                </form>
              <% } else { %>
                <form method="POST"
                      action="/admin/books/<%= b._id %>/status">
                  <input type="hidden" name="status" value="published">
                  <button class="btn btn-sm" type="submit">Publish</button>
                </form>
              <% } %>

              <form method="POST"
                    action="/admin/books/<%= b._id %>/delete"
                    data-confirm="Delete this book and its uploaded files permanently?">
                <button class="btn btn-sm" type="submit">Delete Book</button>
              </form>

            </div>

          </div>
        <% }) %>

      <% } %>

      <% if (bookPagination && bookPagination.totalPages > 1) { %>
        <nav class="admin-pagination" aria-label="Book management pages">
          <% if (bookPagination.page > 1) { %>
            <a href="/admin?bookPage=<%= bookPagination.page - 1 %>#book-management">Previous</a>
          <% } %>

          <span>
            Page <%= bookPagination.page %> of <%= bookPagination.totalPages %>
            (Total: <%= bookPagination.total %> books)
          </span>

          <% if (bookPagination.page < bookPagination.totalPages) { %>
            <a href="/admin?bookPage=<%= bookPagination.page + 1 %>#book-management">Next</a>
          <% } %>
        </nav>
      <% } %>
    </section>

    <!-- Contact Messages -->

    <section class="admin-section" id="contact-management">
      <h2>Recent Contact Messages (<%= stats.contacts %>)</h2>

      <% if (!contacts.length) { %>
        <p class="empty">No messages yet.</p>
      <% } else { %>

        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% contacts.forEach(c => { %>
                <tr>
                  <td><%= c.name %></td>
                  <td><%= c.email %></td>
                  <td><%= c.subject || '-' %></td>

                  <td>
                    <%= c.createdAt
                      ? new Date(c.createdAt).toLocaleDateString()
                      : '-' %>
                  </td>

                  <td>
                    <span class="admin-status">
                      <%= c.isRead ? 'Read' : 'New' %>
                    </span>
                    <span class="admin-status">
                      <%= c.replied ? 'Replied' : 'Not Replied' %>
                    </span>
                  </td>

                  <td>
                    <div class="admin-actions">

                      <a class="btn btn-sm" href="/admin/contacts/<%= c.messageId %>">View</a>

                      <% if (!c.isRead) { %>
                        <form method="POST"
                              action="/admin/contacts/<%= c.messageId %>/read">
                          <button class="btn btn-sm" type="submit">Mark Read</button>
                        </form>
                      <% } %>

                      <% if (!c.replied) { %>
                        <form method="POST"
                              action="/admin/contacts/<%= c.messageId %>/replied">
                          <button class="btn btn-sm" type="submit">Mark Replied</button>
                        </form>
                      <% } %>

                      <form method="POST"
                            action="/admin/contacts/<%= c.messageId %>/delete"
                            data-confirm="Delete this message?">
                        <button class="btn btn-sm" type="submit">Delete</button>
                      </form>

                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      <% } %>
    </section>

  <% } %>
</div>

<%- include('../partials/footer') %>
