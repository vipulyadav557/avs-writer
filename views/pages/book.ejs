
<%- include('../partials/header') %>

<section class="page-hero">
  <h1><%= book.title %></h1>
  <% if (book.subtitle) { %>
    <p><%= book.subtitle %></p>
  <% } %>
</section>

<section class="book-detail">

  <div class="book-detail-cover">
    <% if (book.coverUrl) { %>
      <img
        src="/books/<%= encodeURIComponent(book.slug) %>/cover"
        alt="<%= book.title %> cover"
      >
    <% } else { %>
      <div class="cover-fallback">📖</div>
    <% } %>
  </div>

  <div class="book-detail-info">

    <h2>About This Book</h2>

    <p><strong>Author:</strong> <%= book.author || 'Vipul Kumar Yadav' %></p>

    <% if (book.language) { %>
      <p><strong>Language:</strong> <%= book.language %></p>
    <% } %>

    <% if (book.publisher) { %>
      <p><strong>Publisher:</strong> <%= book.publisher %></p>
    <% } %>

    <% if (book.publishedDate) { %>
      <p><strong>Published:</strong> <%= new Date(book.publishedDate).toLocaleDateString('en-IN') %></p>
    <% } %>

    <% if (book.pages) { %>
      <p><strong>Pages:</strong> <%= book.pages %></p>
    <% } %>

    <% if (book.isbn) { %>
      <p><strong>ISBN:</strong> <%= book.isbn %></p>
    <% } %>

    <% if (book.categories && book.categories.length) { %>
      <div class="book-cats">
        <% book.categories.forEach(c => { %>
          <span class="tag"><%= c %></span>
        <% }) %>
      </div>
    <% } %>

    <% if (book.description) { %>
      <div class="book-description">
        <h3>Description</h3>
        <p><%= book.description %></p>
      </div>
    <% } %>

    <div class="book-actions">
      <% if (book.pdfPath || book.pdfUrl) { %>
        <a
          class="btn"
          href="/books/<%= encodeURIComponent(book.slug) %>/pdf"
          target="_blank"
          rel="noopener"
        >
          Read PDF
        </a>

        <a
          class="btn btn-ghost"
          href="/books/<%= encodeURIComponent(book.slug) %>/pdf?download=1"
        >
          Download PDF
        </a>
      <% } %>
    </div>

  </div>
</section>

<% if (book.tableOfContents && book.tableOfContents.length) { %>
  <section class="book-extra">
    <h2>Table of Contents</h2>
    <ol>
      <% book.tableOfContents.forEach(item => { %>
        <li><%= item %></li>
      <% }) %>
    </ol>
  </section>
<% } %>

<% if (book.whatReadersLearn && book.whatReadersLearn.length) { %>
  <section class="book-extra">
    <h2>What You Will Learn</h2>
    <ul>
      <% book.whatReadersLearn.forEach(item => { %>
        <li><%= item %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (book.authorIntro) { %>
  <section class="book-extra">
    <h2>About the Author</h2>
    <p><%= book.authorIntro %></p>
  </section>
<% } %>

<div class="book-back">
  <a href="/books" class="btn btn-ghost">← Back to Books</a>
</div>

<%- include('../partials/footer') %>
