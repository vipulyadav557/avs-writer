
<%- include('../partials/header') %>

<style>
.profile-settings {
    max-width: 750px;
    margin: 40px auto;
    padding: 25px;
    background: #171717;
    border: 1px solid #333;
    border-radius: 14px;
    color: #fff;
}

.profile-settings h1 {
    margin-bottom: 10px;
}

.profile-settings .subtitle {
    color: #aaa;
    margin-bottom: 25px;
}

.profile-form-group {
    margin-bottom: 22px;
}

.profile-form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
}

.profile-form-group input,
.profile-form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #444;
    border-radius: 8px;
    background: #222;
    color: #fff;
    font: inherit;
}

.profile-form-group textarea {
    min-height: 140px;
    resize: vertical;
}

.profile-form-group input:focus,
.profile-form-group textarea:focus {
    outline: none;
    border-color: #aaa;
}

.profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    background: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
    margin-bottom: 15px;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-errors {
    background: #421f1f;
    border: 1px solid #843d3d;
    color: #ffbaba;
    padding: 12px 18px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.profile-errors p {
    margin: 5px 0;
}

.profile-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 25px;
}

.profile-actions button,
.profile-actions a {
    padding: 11px 20px;
    border-radius: 7px;
    border: none;
    text-decoration: none;
    cursor: pointer;
    font-weight: 600;
}

.profile-save {
    background: #fff;
    color: #111;
}

.profile-cancel {
    background: #333;
    color: #fff;
}

.profile-help {
    color: #999;
    font-size: 13px;
    margin-top: 7px;
}

@media (max-width: 550px) {
    .profile-settings {
        margin: 20px 12px;
        padding: 18px;
    }
}
</style>

<main class="profile-settings">

    <h1>Edit Writer Profile</h1>
    <p class="subtitle">Update your public writer information.</p>

    <% if (errors && errors.length) { %>
        <div class="profile-errors">
            <% errors.forEach(error => { %>
                <p><%= error.msg %></p>
            <% }) %>
        </div>
    <% } %>

    <form
        action="/writer/profile"
        method="POST"
        enctype="multipart/form-data"
    >

        <div class="profile-form-group">
            <label>Profile Photo</label>

            <div class="profile-avatar">
                <% if (user.profile_photo) { %>
                    <img
                        src="/author/photo/<%= encodeURIComponent(user.profile_photo) %>"
                        alt="Profile Photo"
                    >
                <% } else { %>
                    <%= user.name.charAt(0).toUpperCase() %>
                <% } %>
            </div>

            <input
                type="file"
                name="profilePhoto"
                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
            >

            <p class="profile-help">
                JPG, PNG or WEBP. Maximum file size: 2 MB.
            </p>
        </div>

        <div class="profile-form-group">
            <label for="name">Writer Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= user.name %>"
                maxlength="100"
                required
            >
        </div>

        <div class="profile-form-group">
            <label for="bio">About Me / Bio</label>
            <textarea
                id="bio"
                name="bio"
                maxlength="1000"
                placeholder="Write something about yourself..."
            ><%= user.bio || '' %></textarea>

            <p class="profile-help">Maximum 1000 characters.</p>
        </div>

        <div class="profile-form-group">
            <label>Email Address</label>
            <input
                type="email"
                value="<%= user.email %>"
                disabled
            >
            <p class="profile-help">
                Email address cannot be changed here.
            </p>
        </div>

        <div class="profile-actions">
            <button type="submit" class="profile-save">
                Save Profile
            </button>

            <a href="/writer" class="profile-cancel">
                Cancel
            </a>
        </div>

    </form>

</main>

<%- include('../partials/footer') %>
