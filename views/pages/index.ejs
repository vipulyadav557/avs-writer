
<%- include('../partials/header') %>

<%
const homeCategories = [
  { name: 'Shayari', description: 'Feelings expressed in beautiful words', icon: 'shayari' },
  { name: 'Ghazal', description: 'Explore the beauty of ghazals', icon: 'ghazal' },
  { name: 'Nazm', description: 'Thoughtful and meaningful poetry', icon: 'nazm' },
  { name: 'Kavita', description: 'Discover Hindi poems and expressions', icon: 'kavita' },
  { name: 'Bhojpuri Song', description: 'Celebrate Bhojpuri creativity', icon: 'bhojpuri geet' },
  { name: 'Kahani', description: 'Stories that leave an impression', icon: 'kahani' }
];

const homeLanguages = [
  { name: 'Hindi', native: 'हिन्दी', description: 'Hindi writings and poetry' },
  { name: 'Urdu', native: 'اردو', description: 'Urdu poetry and literature' },
  { name: 'English', native: 'English', description: 'Creative English writing' },
  { name: 'Bhojpuri', native: 'भोजपुरी', description: 'Bhojpuri poems and stories' }
];
%>

<style>
.home-section {
  max-width: 1200px;
  margin: 55px auto;
  padding: 0 20px;
  color: #f5f5f5;
}

.home-section h2 {
  font-size: 30px;
  margin-bottom: 8px;
}

.section-intro {
  color: #aaa;
  margin-bottom: 25px;
}

.home-hero {
  padding: 85px 25px;
  text-align: center;
  border-radius: 20px;
  background: linear-gradient( 1deg, #251b36, #4c4a55, #85819f);
  color: white;
}

.home-hero h1 {
  font-size: clamp(38px, 6vw, 64px);
  margin-bottom: 15px;
}

.home-hero p {
  max-width: 650px;
  margin: 0 auto 25px;
  line-height: 1.8;
  color: #e0d8e9;
}

.home-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.home-poem-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin-top: 25px;
}

.home-poem-card {
  overflow: hidden;
  background: #fff;
  color: #24202b;
  border-radius: 14px;
  padding: 22px;
  box-shadow: 0 5px 20px rgba(0,0,0,.15);
}

.home-poem-card h3 {
  font-size: 21px;
  margin-bottom: 12px;
}

.home-poem-card p {
  color: #555;
  line-height: 1.8;
}

.home-poem-meta {
  margin-top: 18px;
  font-size: 13px;
  color: #777;
}

.home-poem-card img {
  width: 100%;
  max-height: 190px;
  object-fit: cover;
  border-radius: 9px;
  margin-bottom: 15px;
}

/* Featured Poetry Square Images */

.featured-grid .home-poem-card img {
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  max-height: none;
  object-fit: cover;
  border-radius: 10px;
}

.home-read-more {
  display: inline-block;
  margin-top: 15px;
  color: #7544a1;
  font-weight: bold;
  text-decoration: none;
}

.home-read-more:hover {
  text-decoration: underline;
}

.home-empty {
  color: #aaa;
  padding: 20px 0;
}

/* Explore Categories */

.explore-category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 25px;
}

.explore-category-card {
  display: block;
  text-decoration: none;
  color: #fff;
  background: linear-gradient(135deg, #30243f, #49305d);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 15px;
  padding: 25px 20px;
  transition: transform .2s, border-color .2s;
}

.explore-category-card:hover {
  transform: translateY(-5px);
  border-color: #bd91e8;
}

.explore-category-icon {
  font-size: 32px;
  display: block;
  margin-bottom: 14px;
}

.explore-category-card h3 {
  margin: 0 0 9px;
  font-size: 20px;
}

.explore-category-card p {
  color: #c5bacf;
  font-size: 14px;
  line-height: 1.6;
  margin: 0;
}

/* Explore Languages */

.explore-language-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 25px;
}

.explore-language-card {
  display: block;
  text-align: center;
  text-decoration: none;
  color: #292238;
  background: #fff;
  padding: 27px 15px;
  border-radius: 14px;
  transition: transform .2s, box-shadow .2s;
}

.explore-language-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 22px rgba(0,0,0,.2);
}

.explore-language-native {
  display: block;
  font-size: 27px;
  font-weight: bold;
  margin-bottom: 10px;
}

.explore-language-card h3 {
  margin: 0 0 7px;
  font-size: 18px;
}

.explore-language-card p {
  color: #777;
  font-size: 13px;
  margin: 0;
  line-height: 1.5;
}

.home-cta {
  text-align: center;
  padding: 45px 20px;
  border-radius: 16px;
  background: #292238;
}

@media(max-width: 800px) {
  .home-poem-grid,
  .explore-category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .explore-language-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media(max-width: 550px) {
  .home-poem-grid,
  .explore-category-grid,
  .explore-language-grid {
    grid-template-columns: 1fr;
  }

  .home-hero {
    padding: 55px 18px;
  }
}
</style>

<section class="home-hero">
  <h1>AVS Writer</h1>
  <h4>Astitva • Vishwas • Sneh
अस्तित्व में विश्वास और विश्वास में प्रेम।</h4>
  <p>
    A beautiful home for poetry, shayari, ghazals and stories.
    Discover words that touch the heart and share your own creativity.
  </p>

  <div class="home-actions">
    <a class="btn" href="/writer/new">Start Writing</a>
    <a class="btn btn-ghost" href="/poems">Explore Poetry</a>
  </div>
</section>

<section class="home-section">
  <h2>Featured Poetry</h2>
  <p class="section-intro">
    Handpicked poems selected by our editors.
  </p>

  <div class="home-poem-grid featured-grid">
    <% featuredPoems.forEach(poem => { %>
      <article class="home-poem-card" dir="<%= poem.language === 'Urdu' ? 'rtl' : 'ltr' %>">

        <% if (poem.imageMimeType) { %>
          <img src="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/image" alt="<%= poem.title %>">
        <% } else if (poem.imageUrl && /^https?:\/\//i.test(poem.imageUrl)) { %>
          <img src="<%= poem.imageUrl %>" alt="<%= poem.title %>">
        <% } %>

        <h3><%= poem.title %></h3>
        <p><%= poem.body.substring(0, 150) %><%= poem.body.length > 150 ? '...' : '' %></p>

        <div class="home-poem-meta">
          By <%= poem.author %> · <%= poem.category %>
        </div>

        <a class="home-read-more" href="/poems/<%= encodeURIComponent(poem.slug) %>">
          Read More →
        </a>
      </article>
    <% }) %>
  </div>

  <% if (!featuredPoems.length) { %>
    <p class="home-empty">Featured poems will appear here soon.</p>
  <% } %>
</section>

<!-- Explore by Category -->

<section class="home-section">
  <h2>Explore by Category</h2>
  <p class="section-intro">
    Discover poetry, stories and creative expressions by category.
  </p>

  <div class="explore-category-grid">
    <% homeCategories.forEach(category => { %>
      <a class="explore-category-card"
         href="/poems?category=<%= encodeURIComponent(category.name) %>">

        <img
  class="explore-category-icon"
 src="/images/<%= category.icon %>.jpeg"
  alt="<%= category.name %> icon"
  loading="lazy"
>
        <h3><%= category.name %></h3>
        <p><%= category.description %></p>
      </a>
    <% }) %>
  </div>
</section>

<!-- Explore by Language -->

<section class="home-section">
  <h2>Explore by Language</h2>
  <p class="section-intro">
    Read beautiful creations in the language you love.
  </p>

  <div class="explore-language-grid">
    <% homeLanguages.forEach(language => { %>
      <a class="explore-language-card"
         href="/poems?language=<%= encodeURIComponent(language.name) %>">

        <span class="explore-language-native"><%= language.native %></span>
        <h3><%= language.name %></h3>
        <p><%= language.description %></p>
      </a>
    <% }) %>
  </div>
</section>

<section class="home-section">
  <h2>Latest Poetry</h2>
  <p class="section-intro">
    Explore the latest published creations from our writers.
  </p>

  <div class="home-poem-grid">
    <% latestPoems.forEach(poem => { %>
      <article class="home-poem-card" dir="<%= poem.language === 'Urdu' ? 'rtl' : 'ltr' %>">

        <% if (poem.imageMimeType) { %>
          <img src="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/image" alt="<%= poem.title %>">
        <% } else if (poem.imageUrl && /^https?:\/\//i.test(poem.imageUrl)) { %>
          <img src="<%= poem.imageUrl %>" alt="<%= poem.title %>">
        <% } %>

        <h3><%= poem.title %></h3>
        <p><%= poem.body.substring(0, 150) %><%= poem.body.length > 150 ? '...' : '' %></p>

        <div class="home-poem-meta">
          By <%= poem.author %> · <%= poem.category %>
        </div>

        <a class="home-read-more" href="/poems/<%= encodeURIComponent(poem.slug) %>">
          Read More →
        </a>
      </article>
    <% }) %>
  </div>

  <% if (!latestPoems.length) { %>
    <p class="home-empty">New poems will appear here soon.</p>
  <% } %>

  <div style="text-align:center; margin-top:30px;">
    <a class="btn" href="/poems">Explore All Poetry</a>
  </div>
</section>

<section class="home-section home-cta">
  <h2>Your Words Deserve to Be Read</h2>
  <p class="section-intro">
    Join AVS Writer and share your poetry, stories and thoughts with readers.
  </p>
  <a class="btn" href="/writer/new">Become a Writer</a>
</section>

<%- include('../partials/footer') %>
