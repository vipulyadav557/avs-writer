<%
const homeCategories = [
  { name: 'Ghazal', description: 'Explore the beauty of ghazals', icon: 'ghazal' },
  { name: 'Nazm', description: 'Thoughtful and meaningful poetry', icon: 'nazm' },
  { name: 'Kavita', description: 'Discover Hindi poems and expressions', icon: 'kavita' },
  { name: 'Kahani', description: 'Stories that leave an impression', icon: 'kahani' }
];

const homeLanguages = [
  { name: 'Hindi', native: 'à¤¹à¤¿à¤¨à¥à¤¦à¥€', description: 'Hindi writings and poetry' },
  { name: 'Urdu', native: 'Ø§Ø±Ø¯Ùˆ', description: 'Urdu poetry and literature' },
  { name: 'English', native: 'English', description: 'Creative English writing' },
  { name: 'Bhojpuri', native: 'à¤à¥‹à¤œà¤ªà¥à¤°à¥€', description: 'Bhojpuri poems and stories' }
];
%>

<section class="home-hero">
  <h1>AVS Writer</h1>
  <h4 class="hero-mantra">
    <span class="hero-word hero-word-one">Astitva</span>
    <span class="hero-word hero-word-two"> â€¢ Vishwas</span>
    <span class="hero-word hero-word-three"> â€¢ Sneh</span>
    <span class="hero-hindi">à¤…à¤¸à¥à¤¤à¤¿à¤¤à¥à¤µ à¤®à¥‡à¤‚ à¤µà¤¿à¤¶à¥à¤µà¤¾à¤¸ à¤”à¤° à¤µà¤¿à¤¶à¥à¤µà¤¾à¤¸ à¤®à¥‡à¤‚ à¤ªà¥à¤°à¥‡à¤®à¥¤</span>
  </h4>
  <p>
    A beautiful home for poetry, shayari, ghazals and stories.
    Discover words that touch the heart and share your own creativity.
  </p>

  <div class="home-actions">
    <a class="btn" href="/writer/new">Start Writing</a>
    <a class="btn btn-ghost" href="/poems">Explore Poetry</a>
  </div>
</section>

<section class="home-section">
  <h2>Featured Poetry</h2>
  <p class="section-intro">
    Handpicked poems selected by our editors.
  </p>

  <div class="home-poem-grid featured-grid">
    <% featuredPoems.forEach(poem => { %>
      <article class="home-poem-card" dir="<%= poem.language === 'Urdu' ? 'rtl' : 'ltr' %>">

        <% if (poem.imageMimeType) { %>
          <img src="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/image" alt="<%= poem.title %>">
        <% } else if (poem.imageUrl && /^https?:\/\//i.test(poem.imageUrl)) { %>
          <img src="<%= poem.imageUrl %>" alt="<%= poem.title %>">
        <% } %>

        <h3><%= poem.title %></h3>
        <p><%= poem.body.substring(0, 150) %><%= poem.body.length > 150 ? '...' : '' %></p>

        <div class="home-poem-meta">
          By <%= poem.author %> Â· <%= poem.category %>
        </div>

        <a class="home-read-more" href="/poems/<%= encodeURIComponent(poem.slug) %>">
          Read More â†’
        </a>
      </article>
    <% }) %>
  </div>

  <% if (!featuredPoems.length) { %>
    <p class="home-empty">Featured poems will appear here soon.</p>
  <% } %>
</section>

<!-- Explore by Category -->

<section class="home-section">
  <h2>Explore by Category</h2>
  <p class="section-intro">
    Discover poetry, stories and creative expressions by category.
  </p>

  <div class="explore-category-grid">
    <% homeCategories.forEach(category => { %>
      <a class="explore-category-card"
         href="/poems?category=<%= encodeURIComponent(category.name) %>">

        <img
          class="explore-category-icon"
          src="/images/<%= category.icon %>.jpeg"
          alt="<%= category.name %> icon"
          loading="lazy"
        >

        <h3><%= category.name %></h3>
        <p><%= category.description %></p>
      </a>
    <% }) %>
  </div>
</section>

<!-- Explore by Language -->

<section class="home-section">
  <h2>Explore by Language</h2>
  <p class="section-intro">
    Read beautiful creations in the language you love.
  </p>

  <div class="explore-language-grid">
    <% homeLanguages.forEach(language => { %>
      <a class="explore-language-card"
         href="/poems?language=<%= encodeURIComponent(language.name) %>">

        <span class="explore-language-native"><%= language.native %></span>
        <h3><%= language.name %></h3>
        <p><%= language.description %></p>
      </a>
    <% }) %>
  </div>
</section>

<section class="home-section">
  <h2>Latest Poetry</h2>
  <p class="section-intro">
    Explore the latest published creations from our writers.
  </p>

  <div class="home-poem-grid">
    <% latestPoems.forEach(poem => { %>
      <article class="home-poem-card" dir="<%= poem.language === 'Urdu' ? 'rtl' : 'ltr' %>">

        <% if (poem.imageMimeType) { %>
          <img src="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/image" alt="<%= poem.title %>">
        <% } else if (poem.imageUrl && /^https?:\/\//i.test(poem.imageUrl)) { %>
          <img src="<%= poem.imageUrl %>" alt="<%= poem.title %>">
        <% } %>

        <h3><%= poem.title %></h3>
        <p><%= poem.body.substring(0, 150) %><%= poem.body.length > 150 ? '...' : '' %></p>

        <div class="home-poem-meta">
          By <%= poem.author %> Â· <%= poem.category %>
        </div>

        <a class="home-read-more" href="/poems/<%= encodeURIComponent(poem.slug) %>">
          Read More â†’
        </a>
      </article>
    <% }) %>
  </div>

  <% if (!latestPoems.length) { %>
    <p class="home-empty">New poems will appear here soon.</p>
  <% } %>

  <div class="home-centered-action">
    <a class="btn" href="/poems">Explore All Poetry</a>
  </div>
</section>

<section class="home-section home-cta">
  <h2>Your Words Deserve to Be Read</h2>
  <p class="section-intro">
    Join AVS Writer and share your poetry, stories and thoughts with readers.
  </p>
  <a class="btn" href="/writer/new">Become a Writer</a>
</section>

<%- include('../partials/footer') %>
