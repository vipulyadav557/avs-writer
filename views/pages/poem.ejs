
<%- include('../partials/header') %>



<article class="poem-detail"
  dir="<%= poem && poem.language === 'Urdu' ? 'rtl' : 'ltr' %>">

  <% if (poem) { %>

    <% if (poem.imageMimeType) { %>
      <img
        src="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/image"
        alt="<%= poem.title %>"
        class="poem-cover">
    <% } else if (poem.imageUrl && !poem.imageUrl.includes('PASTE_')) { %>
      <img
        src="<%= poem.imageUrl %>"
        alt="<%= poem.title %>"
        class="poem-cover"
        data-image-fallback="hide">
    <% } %>

    <h1><%= poem.title %></h1>

    <div class="poem-meta">
      <strong>Author:</strong> <%= poem.author || 'Anonymous' %>
      · <strong>Date:</strong>
      <%= poem.createdAt ? new Date(poem.createdAt).toDateString() : '' %>
      · <strong>Category:</strong> <%= poem.category %>
      · <strong>Language:</strong> <%= poem.language %>

      <% if (poem.mood) { %>
        · <strong>Mood:</strong> <%= poem.mood %>
      <% } %>
    </div>

    <% if (poem.tags && poem.tags.length) { %>
      <div class="poem-tags">
        <% poem.tags.forEach(tag => { %>
          <span class="poem-tag"><%= tag %></span>
        <% }) %>
      </div>
    <% } %>

    <pre class="poem-content"><%= poem.body %></pre>

    <% if (poem.documentMimeType) { %>
      <div class="poem-attachment">
        <a
          class="btn"
          href="/poems/<%= encodeURIComponent(poem.slug) %>/attachment/pdf">
          Download Poem PDF
        </a>
      </div>
    <% } %>

    <button
      type="button"
      class="btn btn-ghost"
      data-copy-poem>
      Copy Poem
    </button>

  <% } else { %>
    <p class="empty">Poem not found.</p>
  <% } %>

  <div class="poem-back">
    <a href="/poems">← Back to Poetry Library</a>
  </div>

</article>

<%- include('../partials/footer') %>
