
<%- include('../partials/header') %>

<style>
.writer-dashboard {
  max-width: 1200px;
  margin: 40px auto;
  padding: 20px;
  color: #f5f5f5;
}

.writer-welcome {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-bottom: 30px;
}

.writer-welcome h1 {
  margin: 0 0 8px;
  font-size: 30px;
}

.writer-welcome p {
  color: #bbb;
  margin: 0;
}

.writer-actions,
.poem-actions,
.attachment-links {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
  align-items: center;
}

.writer-btn {
  display: inline-block;
  padding: 10px 16px;
  border-radius: 8px;
  text-decoration: none;
  background: #d4a84f;
  color: #171717;
  font-weight: 600;
  border: 0;
  cursor: pointer;
}

.writer-btn.secondary {
  background: #333;
  color: #fff;
}

.writer-btn.danger {
  background: #ffe0e0;
  color: #a00000;
}

.writer-stats {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 15px;
  margin-bottom: 30px;
}

.writer-stat {
  background: #fff;
  color: #222;
  padding: 20px;
  border-radius: 12px;
}

.writer-stat h3 {
  margin: 0 0 10px;
  color: #555;
  font-size: 14px;
}

.writer-stat strong {
  font-size: 28px;
}

.writer-section {
  background: #fff;
  color: #222;
  padding: 24px;
  border-radius: 12px;
  overflow-x: auto;
}

.writer-section h2 {
  margin-top: 0;
}

.writer-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 850px;
}

.writer-table th,
.writer-table td {
  padding: 14px 12px;
  border-bottom: 1px solid #eee;
  text-align: left;
  vertical-align: middle;
}

.writer-table th {
  background: #f5f5f5;
  color: #333;
}

.writer-table td {
  color: #444;
}

.status {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  text-transform: capitalize;
}

.status.published {
  background: #d8f5df;
  color: #17652b;
}

.status.draft {
  background: #fff0cc;
  color: #805600;
}

.status.pending {
  background: #dcecff;
  color: #14518c;
}

.status.rejected {
  background: #ffe0e0;
  color: #a00000;
}

.attachment-links a {
  font-size: 13px;
  color: #0756a5;
  text-decoration: none;
  font-weight: 600;
}

.poem-actions form {
  margin: 0;
}

.poem-actions .writer-btn {
  padding: 7px 11px;
  font-size: 12px;
}

.empty-state {
  text-align: center;
  padding: 35px 10px;
  color: #666;
}

@media (max-width: 900px) {
  .writer-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .writer-dashboard {
    padding: 12px;
  }

  .writer-stats {
    grid-template-columns: 1fr 1fr;
  }

  .writer-welcome h1 {
    font-size: 24px;
  }

  .writer-section {
    padding: 15px;
  }
}
</style>

<main class="writer-dashboard">

  <section class="writer-welcome">
    <div>
      <h1>Writer Dashboard</h1>
      <p>
        Welcome, <strong><%= user.name %></strong>!
        Manage your poems and submissions here.
      </p>
    </div>

   <div class="writer-actions">
  <a href="/writer/new" class="writer-btn">+ Write New Poem</a>
  <a href="/writer/profile" class="writer-btn secondary">Edit Profile</a>

  <% if (user.profile_slug) { %>
    <a href="/author/<%= user.profile_slug %>" class="writer-btn secondary">
      View Public Profile
    </a>
  <% } %>

  <a href="/auth/logout" class="writer-btn secondary">Logout</a>
</div>
  </section>

  <section class="writer-stats">

    <div class="writer-stat">
      <h3>Total Poems</h3>
      <strong><%= stats.total %></strong>
    </div>

    <div class="writer-stat">
      <h3>Published</h3>
      <strong><%= stats.published %></strong>
    </div>

    <div class="writer-stat">
      <h3>Drafts</h3>
      <strong><%= stats.drafts %></strong>
    </div>

    <div class="writer-stat">
      <h3>Pending Review</h3>
      <strong><%= stats.pending %></strong>
    </div>

    <div class="writer-stat">
      <h3>Rejected</h3>
      <strong><%= stats.rejected %></strong>
    </div>

  </section>

  <section class="writer-section">

    <h2>My Poems</h2>

    <% if (poems && poems.length > 0) { %>

      <table class="writer-table">

        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Language</th>
            <th>Attachments</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>

          <% poems.forEach(poem => { %>

            <tr>

              <td>
                <strong><%= poem.title %></strong>
              </td>

              <td><%= poem.category %></td>

              <td><%= poem.language %></td>

              <td>
                <div class="attachment-links">

                  <% if (poem.imageMimeType) { %>
                    <a
                      href="/writer/<%= poem._id %>/attachment/image"
                      target="_blank"
                    >View Image</a>
                  <% } %>

                  <% if (poem.documentMimeType) { %>
                    <a href="/writer/<%= poem._id %>/attachment/pdf">
                      Download PDF
                    </a>
                  <% } %>

                  <% if (!poem.imageMimeType && !poem.documentMimeType) { %>
                    <span>None</span>
                  <% } %>

                </div>
              </td>

              <td>
                <span class="status <%= poem.status %>">
                  <%= poem.status %>
                </span>
              </td>

              <td>
                <%= new Date(poem.createdAt).toLocaleDateString('en-IN') %>
              </td>

              <td>
                <div class="poem-actions">

                  <a
                    href="/writer/<%= poem._id %>/edit"
                    class="writer-btn secondary"
                  >Edit</a>

                  <% if (poem.status === 'published') { %>
                    <a
                      href="/poems/<%= poem.slug %>"
                      target="_blank"
                      class="writer-btn"
                    >View</a>
                  <% } %>

                  <form
                    action="/writer/<%= poem._id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this poem?');"
                  >
                    <button
                      type="submit"
                      class="writer-btn danger"
                    >Delete</button>
                  </form>

                </div>
              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    <% } else { %>

      <div class="empty-state">
        <h3>No Poems Yet</h3>
        <p>You haven't written any poems yet.</p>
        <a href="/writer/new" class="writer-btn">Start Writing</a>
      </div>

    <% } %>

  </section>

</main>

<%- include('../partials/footer') %>
