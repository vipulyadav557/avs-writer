
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">

  <title><%= title %> | AVS Writer</title>

  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/pages.css">

  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/">AVS Writer</a>

    <button type="button" class="hamburger" id="menuToggle"
      aria-label="Toggle navigation" aria-controls="nav" aria-expanded="false">☰</button>

    <nav class="nav" id="nav">
      <a href="/">Home</a>
      <a href="/poetry">Poetry</a>
      <a href="/books">Books</a>
      <a href="/contact">Contact</a>

      <a href="https://vipulyadav557.github.io/" target="_blank" rel="noopener noreferrer">
        <i class="fa-solid fa-globe"></i> Portfolio
      </a>

      <% if (locals.currentUser && currentUser.role === 'writer') { %>
        <a href="/writer/new">Write</a>
        <a href="/writer">Writer Dashboard</a>
      <% } else if (!locals.currentUser) { %>
        <a href="/writer/new">Write</a>
        <a href="/writer">Writer</a>
      <% } %>

      <% if (locals.currentUser && currentUser.role === 'admin') { %>
        <a href="/admin/notifications" class="nav-notifications">
          <i class="fa-solid fa-bell"></i> Notifications

          <% if ((locals.adminUnreadCount || 0) > 0) { %>
            <span class="notification-badge">
              <%= adminUnreadCount %>
            </span>
          <% } %>
        </a>

        <a href="/admin">Admin Dashboard</a>
      <% } %>

      <% if (locals.currentUser) { %>
        <form action="/auth/logout" method="POST" class="logout-form">
          <button type="submit">Logout</button>
        </form>
      <% } %>
    </nav>
  </div>
</header>

<main class="container">
